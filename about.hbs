<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>NapkinUML - Third-Party Licenses</title>
<style>
  body { font-family: -apple-system, "Segoe UI", sans-serif; max-width: 960px; margin: 2em auto; padding: 0 1em; color: #222; }
  h2 { border-bottom: 1px solid #ddd; padding-bottom: .3em; margin-top: 2em; }
  ul.crates { columns: 2; }
  pre { white-space: pre-wrap; background: #f6f6f6; padding: 1em; border-radius: 4px; font-size: 12px; }
</style>
</head>
<body>
<h1>Third-Party Licenses</h1>
<p>NapkinUML is built with the open source software listed below.</p>

<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul class="crates">
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
